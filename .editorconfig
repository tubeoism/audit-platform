root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,xml,xaml,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true
# Library code: do not force ConfigureAwait(false) on every await.
dotnet_diagnostic.CA2007.severity = none
# Domain types expose read-only collections deliberately.
dotnet_diagnostic.CA1002.severity = none
# Localised resources come later.
dotnet_diagnostic.CA1303.severity = none

[tests/**.cs]
# Test method names use underscores.
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none

[src/**/Migrations/*.cs]
# Generated by dotnet-ef.
generated_code = true
dotnet_analyzer_diagnostic.severity = none
csharp_style_namespace_declarations = block_scoped:silent
