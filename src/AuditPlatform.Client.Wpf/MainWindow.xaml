<Window x:Class="AuditPlatform.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AuditPlatform.Client.Core.ViewModels;assembly=AuditPlatform.Client.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Audit Platform" Height="720" Width="1200" MinHeight="480" MinWidth="800">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding MasterUrl}" />
      <Separator />
      <StatusBarItem Content="{Binding StatusText}" />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding LastError}" Foreground="Firebrick" />
      </StatusBarItem>
    </StatusBar>
    <Grid Margin="24">
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
        <TextBlock Text="Audit Platform" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,24" TextWrapping="Wrap" Foreground="DimGray"
                   Text="Skeleton shell. Engagement list, working-paper forms, evidence and review notes are built in the client phase." />
        <Button Content="Connect to master" Command="{Binding ConnectCommand}" Padding="16,6" HorizontalAlignment="Left" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
