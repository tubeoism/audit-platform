<Window x:Class="AuditPlatform.Client.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AuditPlatform.Client.Core.ViewModels;assembly=AuditPlatform.Client.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ShellViewModel}"
        Title="Audit Platform" Height="800" Width="1360" MinHeight="560" MinWidth="1000" FontSize="13"
        Closing="Window_Closing">
  <DockPanel>
    <!-- Who is signed in, and the two actions that concern the whole laptop. -->
    <Border DockPanel.Dock="Top" Background="#F3F5F8" BorderBrush="#D5DAE1" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="Đồng bộ ngay" Command="{Binding SyncNowCommand}" Margin="0,0,8,0" />
          <Button Content="Đăng xuất" Command="{Binding SignOutCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding UserText}" VerticalAlignment="Center" FontWeight="SemiBold" />
      </DockPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem Content="{Binding MasterUrl}" />
      <Separator />
      <StatusBarItem Content="{Binding StatusText}" />
      <Separator />
      <StatusBarItem Content="{Binding OutboxText}" />
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="{Binding LastError}" Foreground="Firebrick" TextTrimming="CharacterEllipsis" MaxWidth="560"
                   ToolTip="{Binding LastError}" />
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230" />
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Engagements assigned to this user. -->
      <DockPanel Grid.Column="0" Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Engagement" Style="{StaticResource SectionTitle}" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource Muted}"
                   Visibility="{Binding EmptyText, Converter={StaticResource Present}}" />
        <ListBox ItemsSource="{Binding Engagements}" SelectedItem="{Binding SelectedEngagement}" BorderThickness="0"
                 HorizontalContentAlignment="Stretch">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,5">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding ClientName}" Style="{StaticResource Muted}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Working papers of the selected engagement. -->
      <Border Grid.Column="1" BorderBrush="#D5DAE1" BorderThickness="1,0,1,0"
              Visibility="{Binding Engagement, Converter={StaticResource Present}}">
        <DockPanel Margin="12" DataContext="{Binding Engagement}">
          <TextBlock DockPanel.Dock="Top" Text="{Binding Heading}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock DockPanel.Dock="Top" Text="{Binding Detail}" Style="{StaticResource Muted}" Margin="0,2,0,0" />

          <StackPanel DockPanel.Dock="Top" Visibility="{Binding CanCreate, Converter={StaticResource Present}}">
            <TextBlock Text="Thêm giấy làm việc từ thủ tục" Style="{StaticResource SectionTitle}" />
            <ComboBox ItemsSource="{Binding Areas}" SelectedItem="{Binding SelectedArea}" Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding AreaTemplates}" SelectedItem="{Binding SelectedTemplate}" Margin="0,0,0,6" />
            <Button Content="Tạo giấy làm việc" Command="{Binding CreatePaperCommand}" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Error, Converter={StaticResource Present}}" />
          </StackPanel>

          <TextBlock DockPanel.Dock="Top" Text="Giấy làm việc" Style="{StaticResource SectionTitle}" />
          <ListBox ItemsSource="{Binding Papers}" SelectedItem="{Binding SelectedPaper}" BorderThickness="0"
                   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,5">
                  <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding PreparerName, Mode=OneWay}" />
                  </TextBlock>
                  <TextBlock Text="{Binding Flags}" Foreground="#9A5B00" TextWrapping="Wrap"
                             Visibility="{Binding Flags, Converter={StaticResource Present}}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- The form of the selected working paper. -->
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding Engagement.Paper, Converter={StaticResource Present}}">
        <StackPanel x:Name="PaperPanel" Margin="24,16,24,32" MaxWidth="900" HorizontalAlignment="Left"
                    DataContext="{Binding Engagement.Paper}">
          <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
            <Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · Người lập: " /><Run Text="{Binding PreparerName, Mode=OneWay}" />
          </TextBlock>

          <Border Background="#FFF6DD" BorderBrush="#E3C56A" BorderThickness="1" Padding="10,8" Margin="0,12,0,0"
                  Visibility="{Binding Notice, Converter={StaticResource Present}}">
            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
          </Border>
          <Border Background="#FDECEC" BorderBrush="#E0A3A3" BorderThickness="1" Padding="10,8" Margin="0,12,0,0"
                  Visibility="{Binding Error, Converter={StaticResource Present}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
          </Border>

          <!-- Same-field conflicts: both values are kept until a person decides. -->
          <StackPanel Visibility="{Binding HasConflicts, Converter={StaticResource Present}}">
            <TextBlock Text="Xung đột chờ xử lý" Style="{StaticResource SectionTitle}" Foreground="#9A5B00" />
            <ItemsControl ItemsSource="{Binding Conflicts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E3C56A" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                      <TextBlock Text="{Binding FieldLabel}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="16" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="Giá trị đang giữ trên máy chủ" Style="{StaticResource Muted}" />
                          <TextBox Text="{Binding CurrentValue, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="6" Margin="0,4,0,8"
                                   Background="#F7F8FA" />
                          <Button Content="Giữ giá trị này" HorizontalAlignment="Left" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.KeepCurrentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  Visibility="{Binding CanResolve, Converter={StaticResource Present}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Style="{StaticResource Muted}">
                            <Run Text="Giá trị đề xuất của " /><Run Text="{Binding AuthorName, Mode=OneWay}" />
                          </TextBlock>
                          <TextBox Text="{Binding ProposedValue, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Padding="6" Margin="0,4,0,8"
                                   Background="#F7F8FA" />
                          <Button Content="Dùng giá trị này" HorizontalAlignment="Left" CommandParameter="{Binding}"
                                  Command="{Binding DataContext.UseProposedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                  Visibility="{Binding CanResolve, Converter={StaticResource Present}}" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0"
                                 Text="Người lập giấy làm việc này hoặc Trưởng nhóm quyết định. Cả hai giá trị được giữ trong lịch sử."
                                 Visibility="{Binding CanResolve, Converter={StaticResource Present}, ConverterParameter=absent}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Changes of this user that the master refused. -->
          <StackPanel Visibility="{Binding HasAttention, Converter={StaticResource Present}}">
            <TextBlock Text="Thay đổi bị máy chủ từ chối" Style="{StaticResource SectionTitle}" Foreground="Firebrick" />
            <ItemsControl ItemsSource="{Binding Attention}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="#E0A3A3" BorderThickness="1" Padding="12" Margin="0,0,0,8">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="Đã đọc, bỏ" VerticalAlignment="Top" Margin="12,0,0,0" CommandParameter="{Binding}"
                              Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                      <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <TextBlock Text="Thủ tục" Style="{StaticResource SectionTitle}" />
          <TextBlock Text="{Binding Procedure}" TextWrapping="Wrap" />

          <TextBlock Text="Bằng chứng cần kiểm tra" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding EvidenceToCheck}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,2">
                  <Run Text="• " /><Run Text="{Binding Mode=OneWay}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Text="Nội dung thực hiện và kết quả" Style="{StaticResource SectionTitle}" />
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,14">
                  <TextBlock Text="{Binding Label}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                           MinHeight="54" MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,4,0,2"
                           LostKeyboardFocus="Field_LostKeyboardFocus"
                           IsReadOnly="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Inverse}}" />
                  <TextBlock Text="{Binding StateText}" FontSize="11.5">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                            <Setter Property="Foreground" Value="#9A5B00" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <StackPanel Visibility="{Binding SignOffs.Count, Converter={StaticResource Present}}">
            <TextBlock Text="Ký soát xét" Style="{StaticResource SectionTitle}" />
            <ItemsControl ItemsSource="{Binding SignOffs}" />
          </StackPanel>

          <Button Content="Gửi soát xét" Command="{Binding SubmitCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                  Visibility="{Binding CanSubmit, Converter={StaticResource Present}}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
