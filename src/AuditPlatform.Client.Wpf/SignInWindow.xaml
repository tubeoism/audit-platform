<Window x:Class="AuditPlatform.Client.Wpf.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AuditPlatform.Client.Core.ViewModels;assembly=AuditPlatform.Client.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SignInViewModel}"
        Title="Audit Platform · Đăng nhập" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" FontSize="13">
  <StackPanel Margin="28">
    <TextBlock Text="Audit Platform" FontSize="24" FontWeight="SemiBold" />
    <TextBlock Text="Đăng nhập bằng e-mail công việc, mật khẩu và mã xác thực." Style="{StaticResource Muted}" Margin="0,4,0,18" />

    <TextBlock Text="E-mail" />
    <TextBox x:Name="EmailBox" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,12" Padding="6,5" />

    <TextBlock Text="Mật khẩu" />
    <PasswordBox x:Name="PasswordBox" Margin="0,4,0,12" Padding="6,5" />

    <TextBlock Text="{Binding CodeLabel}" />
    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="6,5" />
    <CheckBox Content="Dùng mã khôi phục (khi không có điện thoại)" IsChecked="{Binding UseRecoveryCode}" Margin="0,0,0,14" />

    <TextBlock Text="{Binding Error}" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,0,0,12"
               Visibility="{Binding Error, Converter={StaticResource Present}}" />

    <Button Content="Đăng nhập" IsDefault="True" Click="SignIn_Click" HorizontalAlignment="Left"
            IsEnabled="{Binding IsBusy, Converter={StaticResource Inverse}}" />
    <TextBlock Style="{StaticResource Muted}" Margin="0,16,0,0"
               Text="Quên mật khẩu hoặc chưa có tài khoản: mở liên kết trong e-mail mời, hoặc trang /account/forgot trên máy chủ." />
  </StackPanel>
</Window>
