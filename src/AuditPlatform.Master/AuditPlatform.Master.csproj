<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <Description>Master node: system of record, sync coordinator, engagement lock, AI gateway. Runs on Oracle Cloud Arm (linux-arm64).</Description>
    <RuntimeIdentifiers>linux-arm64;linux-x64</RuntimeIdentifiers>
    <UserSecretsId>audit-platform-master</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
    <PackageReference Include="QRCoder" />
  </ItemGroup>
  <ItemGroup>
    <!-- Common passwords of 12+ characters (SecLists, MIT licence); see Auth/Resources/README.md. -->
    <EmbeddedResource Include="Auth\Resources\common-passwords.txt.gz" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AuditPlatform.AuditLog\AuditPlatform.AuditLog.csproj" />
    <ProjectReference Include="..\AuditPlatform.Contracts\AuditPlatform.Contracts.csproj" />
    <ProjectReference Include="..\AuditPlatform.Domain\AuditPlatform.Domain.csproj" />
    <ProjectReference Include="..\AuditPlatform.Evidence\AuditPlatform.Evidence.csproj" />
    <ProjectReference Include="..\AuditPlatform.Master.Data\AuditPlatform.Master.Data.csproj" />
    <ProjectReference Include="..\AuditPlatform.Sync\AuditPlatform.Sync.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Local development credentials only; never shipped to the VM. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AuditPlatform.Master.Tests" />
  </ItemGroup>
</Project>
