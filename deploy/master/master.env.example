# Copy to /etc/audit-master/master.env on the VM (owner root, mode 0600). Never commit real values.
ConnectionStrings__Master=Host=127.0.0.1;Port=5432;Database=audit_master;Username=audit_app;Password=CHANGE_ME
Master__EvidenceRoot=/srv/audit/evidence

# Cloudflare R2 (bucket audit-live: WAL-G, nightly dumps, live evidence mirror)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Authentication (ADR-0005). Root of the token-signing, TOTP-encryption and token-hashing keys: base64 of 32 random
# bytes. Generate and store it with `sudo audit-auth-key --init` / `--show`; without it the master answers 503 to
# every sign-in. Keep an offline copy next to the backup key.
# Auth__MasterKey=

# Outbound mail for invitations and resets (Brevo transactional email HTTP API, ADR-0005)
# Mail__BrevoApiKey=
# Mail__From=no-reply@audit.io.vn

# Backup alerts (WAL-G checks, failed backups, restore drill reports) go to this address
# BACKUP_ALERT_EMAIL=

# AI gateway (ADR pending; Console API key, master only)
# ANTHROPIC_API_KEY=
